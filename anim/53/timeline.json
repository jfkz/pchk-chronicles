x": 28}, "titus": {"x": 36}, "vitya": {"x": 10}, "shlepa": {"x": 6}, "bagira": {"x": 44}}}, {"id": "m_cem", "t": 5540, "bg": "map", "from": "forest", "to": "cemetery", "title": "На кладбище", "cast": {}}, {"id": "s_cem", "t": 5560, "bg": "cemetery", "title": "Плен на кладбище", "cast": {"yulian": {"x": 10}, "eppi": {"x": 6}, "didi": {"x": 14}, "vitya": {"x": 26}, "shlepa": {"x": 34}, "titus": {"x": 40}, "bagira": {"x": 48}, "sofia": {"x": 55}, "zombie1": {"x": 76}, "zombie2": {"x": 84}, "zombie3": {"x": 44}}}, {"id": "m_nur", "t": 6753, "bg": "map", "from": "cemetery", "to": "nurikfel", "title": "Дорога в Нурикфел", "cast": {}}, {"id": "s_nur", "t": 6775, "bg": "garden", "title": "Нурикфел: скорбящие эльфы", "cast": {"king": {"x": 72}, "sofia": {"x": 14}, "bagira": {"x": 24}, "yulian": {"x": 8}, "vitya": {"x": 4}, "titus": {"x": 18}}}, {"id": "s_angels", "t": 6923, "bg": "garden", "title": "Ангелы-стражи", "cast": {"sofia": {"x": 15}, "vitya": {"x": 8}, "yulian": {"x": 6}, "titus": {"x": 20}, "bagira": {"x": 24}, "shlepa": {"x": 12}, "angel1": {"x": 60}, "angel2": {"x": 68}, "angel3": {"x": 76}}}, {"id": "s_venera", "t": 7119, "bg": "garden", "title": "Сад Венеры", "cast": {"sofia": {"x": 40}, "vitya": {"x": 8}, "yulian": {"x": 14}, "titus": {"x": 20}, "bagira": {"x": 26}, "shlepa": {"x": 32}, "lyosha": {"x": 70}, "venera": {"x": 78}}}], "events": [{"t": 29, "do": "say", "id": "yulian", "text": "Я громила Юлиан! Вы теперь адмиралы Бусти!", "dur": 4}, {"t": 51, "do": "say", "id": "yulian", "text": "У меня для вас 11 новостей!", "dur": 3}, {"t": 131, "do": "say", "id": "zombie1", "text": "Проходите, сударь, осматривайтесь.", "dur": 3}, {"t": 163, "do": "say", "id": "peasant1", "text": "Аренда долгосрочная?", "dur": 2.5}, {"t": 197, "do": "say", "id": "zombie1", "text": "Соседей здесь нет, никто вам не помешает.", "dur": 3.5}, {"t": 212, "do": "say", "id": "zombie1", "text": "Настало время поужинать!", "dur": 3}, {"t": 214, "do": "attack", "id": "zombie1", "target": "peasant1", "dur": 2, "dmg": "укус", "kind": "melee"}, {"t": 226, "do": "enter", "id": "yulian", "x": 22, "from": -10, "dur": 4}, {"t": 229, "do": "say", "id": "yulian", "text": "Как ты поужинаешь, упырь, если я тебе рёбра обломаю?", "dur": 4}, {"t": 240, "do": "say", "id": "zombie1", "text": "Ты у меня будешь на второе!", "dur": 3}, {"t": 251, "do": "say", "id": "yulian", "text": "Секиру оставил дома, справлюсь и так.", "dur": 3.5}, {"t": 263, "do": "attack", "id": "yulian", "target": "zombie1", "dur": 2, "dmg": "удар", "kind": "melee"}, {"t": 284, "do": "say", "id": "yulian", "text": "Аренду по бумажному объявлению искал?", "dur": 3.5}, {"t": 354, "do": "say", "id": "yulian", "text": "Ну всё, упырь, ты мне надоел!", "dur": 3}, {"t": 357, "do": "attack", "id": "yulian", "target": "zombie1", "dur": 2, "dmg": "удар", "kind": "melee"}, {"t": 367, "do": "fx", "kind": "holy", "x": 62, "dur": 4}, {"t": 369, "do": "say", "id": "yulian", "text": "Мощь Солнца!", "dur": 2.5}, {"t": 371, "do": "hurt", "id": "zombie1", "dmg": "святой удар", "dur": 2, "kind": "spell"}, {"t": 374, "do": "die", "id": "zombie1"}, {"t": 377, "do": "say", "id": "peasant1", "text": "Вы спасли меня! Как отблагодарить?", "dur": 3.5}, {"t": 393, "do": "say", "id": "yulian", "text": "Я к сестре и племяннику в отпуск приехал.", "dur": 3.5}, {"t": 403, "do": "exit", "id": "yulian", "x": 110, "dur": 6}, {"t": 425, "do": "fx", "kind": "sparkle", "x": 50, "dur": 4}, {"t": 470, "do": "fx", "kind": "sparkle", "x": 50, "dur": 4}, {"t": 698, "do": "enter", "id": "vitya", "x": 12, "from": -10, "dur": 5}, {"t": 702, "do": "enter", "id": "bagira", "x": 19, "from": -10, "dur": 5}, {"t": 706, "do": "enter", "id": "titus", "x": 26, "from": -10, "dur": 5}, {"t": 709, "do": "move", "id": "yulian", "x": 48, "dur": 3}, {"t": 731, "do": "say", "id": "yulian", "text": "«Мама, не волнуйся. Меня не похитили».", "dur": 4}, {"t": 741, "do": "say", "id": "yulian", "text": "«Мне надо кое-куда сходить и кое-что выяснить».", "dur": 4}, {"t": 762, "do": "say", "id": "yulian", "text": "«Взял у дяди Юлиана все золотые монеты».", "dur": 4}, {"t": 795, "do": "enter", "id": "sofia", "x": 30, "from": -8, "dur": 4}, {"t": 806, "do": "say", "id": "sofia", "text": "Что опять?!", "dur": 2.5}, {"t": 812, "do": "move", "id": "yulian", "x": 40, "dur": 2}, {"t": 817, "do": "say", "id": "sofia", "text": "Я друидка и мать-одиночка по имени София.", "dur": 4}, {"t": 838, "do": "say", "id": "sofia", "text": "Мы заманивали путников и съедали их.", "dur": 3.5}, {"t": 880, "do": "say", "id": "sofia", "text": "Мой сын Лёша перевернул всю нашу жизнь.", "dur": 4}, {"t": 923, "do": "say", "id": "yulian", "text": "Я Юлиан, одиннадцатикратный герой войны с демонами.", "dur": 4.5}, {"t": 988, "do": "say", "id": "yulian", "text": "Найду — дам 11 лещей и в военную семинарию!", "dur": 4}, {"t": 1031, "do": "say", "id": "vitya", "text": "Я охотник-следопыт Витя Мамонтов.", "dur": 3.5}, {"t": 1043, "do": "say", "id": "vitya", "text": "Дружок живёт у меня в желудке.", "dur": 3.5}, {"t": 1074, "do": "say", "id": "vitya", "text": "Лёша убёг после того, как я предложил показать дружка.", "dur": 4.5}, {"t": 1107, "do": "say", "id": "bagira", "text": "Я лесная эльфийка, ниндзя. Зовут Багира.", "dur": 4}, {"t": 1131, "do": "say", "id": "bagira", "text": "Я вышла замуж за дварфа Яруса.", "dur": 3.5}, {"t": 1194, "do": "say", "id": "titus", "text": "Я горный дварф, брат-близнец Яруса, Титус.", "dur": 4}, {"t": 1240, "do": "say", "id": "titus", "text": "Моя борода идеально ухожена.", "dur": 3.5}, {"t": 1289, "do": "say", "id": "titus", "text": "Присмотрю за Багирой и присмотрюсь к одинокой маме.", "dur": 4.5}, {"t": 1324, "do": "say", "id": "peasant1", "text": "У меня есть то, что вас заинтересует.", "dur": 3.5}, {"t": 1346, "do": "say", "id": "peasant1", "text": "Яйцо дракона! Всего за тысячу золотых.", "dur": 4}, {"t": 1380, "do": "say", "id": "peasant1", "text": "Нет денег — платите экипировкой. Раздевайтесь!", "dur": 4}, {"t": 1391, "do": "say", "id": "sofia", "text": "Использую «Истинное зрение».", "dur": 3}, {"t": 1393, "do": "fx", "kind": "sparkle", "x": 72, "dur": 3}, {"t": 1407, "do": "say", "id": "sofia", "text": "Это ложь. Там кукла!", "dur": 3}, {"t": 1563, "do": "move", "id": "sofia", "x": 52, "dur": 4}, {"t": 1586, "do": "say", "id": "peasant3", "text": "Я люблю жареную рыбу, а варёную не люблю.", "dur": 4}, {"t": 1597, "do": "say", "id": "sofia", "text": "Посмотрите, я не испачкалась?", "dur": 3}, {"t": 1612, "do": "move", "id": "titus", "x": 46, "dur": 3}, {"t": 1630, "do": "say", "id": "titus", "text": "Это мои груди!", "dur": 2.5}, {"t": 1675, "do": "say", "id": "peasant2", "text": "У неё грудь сильно испачкалась!", "dur": 3.5}, {"t": 1721, "do": "say", "id": "sofia", "text": "Это варёная или жареная рыба?", "dur": 3}, {"t": 1735, "do": "move", "id": "vitya", "x": 48, "dur": 3}, {"t": 1757, "do": "say", "id": "vitya", "text": "Это варёный хариус. Ты жареное любишь!", "dur": 4}, {"t": 1770, "do": "say", "id": "sofia", "text": "Не видели мальчика? Пять лет, кудрявый.", "dur": 3.5}, {"t": 1805, "do": "fx", "kind": "sparkle", "x": 42, "dur": 6}, {"t": 1815, "do": "move", "id": "bagira", "x": 10, "dur": 3}, {"t": 1822, "do": "status", "id": "bagira", "kind": "invisible"}, {"t": 1870, "do": "fx", "kind": "sparkle", "x": 42, "dur": 6}, {"t": 1885, "do": "say", "id": "peasant1", "text": "Такого не видел. Похоже на рыбу.", "dur": 3.5}, {"t": 1937, "do": "say", "id": "peasant2", "text": "Каброн с ночи, спит в башне. Будить не будем.", "dur": 4}, {"t": 1970, "do": "say", "id": "vitya", "text": "Дружок, пора на выход, пора за работу!", "dur": 3.5}, {"t": 2012, "do": "say", "id": "vitya", "text": "Запускаю Дружка арбалетом в окошко башни.", "dur": 4}, {"t": 2025, "do": "attack", "id": "peasant1", "target": "vitya", "dur": 2, "dmg": "хватает арбалет", "kind": "melee"}, {"t": 2033, "do": "say", "id": "vitya", "text": "Это фейерверк! Ленты вешаем, День города!", "dur": 4}, {"t": 2052, "do": "say", "id": "peasant1", "text": "О, я его, пожалуй, сегодня съем.", "dur": 3.5}, {"t": 2066, "do": "say", "id": "vitya", "text": "Дружок, мы попали в оказию небольшую.", "dur": 3.5}, {"t": 2084, "do": "say", "id": "peasant2", "text": "Вы нападаете на стражу!", "dur": 2.5}, {"t": 2100, "do": "say", "id": "sofia", "text": "Я пошла в башню.", "dur": 2.5}, {"t": 2103, "do": "move", "id": "sofia", "x": 78, "dur": 6}, {"t": 2130, "do": "say", "id": "titus", "text": "Мужики, я тут главный по охране!", "dur": 3.5}, {"t": 2153, "do": "say", "id": "peasant1", "text": "А в отпуске можно порыбачить на хариусов?", "dur": 4}, {"t": 2172, "do": "status", "id": "kabron", "kind": "sleep"}, {"t": 2173, "do": "status", "id": "bagira", "kind": "invisible"}, {"t": 2184, "do": "say", "id": "sofia", "text": "Доброе утро, солнышко.", "dur": 3}, {"t": 2196, "do": "status", "id": "kabron", "kind": "none"}, {"t": 2198, "do": "say", "id": "kabron", "text": "Это сон?", "dur": 2.5}, {"t": 2217, "do": "say", "id": "sofia", "text": "Куда пошёл кудрявый мальчик?", "dur": 3}, {"t": 2249, "do": "say", "id": "kabron", "text": "Мальчик сел в повозку к торговцу маслом.", "dur": 4}, {"t": 2270, "do": "say", "id": "kabron", "text": "Эппиштайн. Его все знают. С ним сын Диди.", "dur": 4}, {"t": 2303, "do": "say", "id": "kabron", "text": "Они из деревни Плежа, день пути на север.", "dur": 4}, {"t": 2326, "do": "fx", "kind": "vines", "x": 84, "dur": 3}, {"t": 2328, "do": "attack", "id": "sofia", "target": "kabron", "dur": 3, "dmg": "мимо", "kind": "spell"}, {"t": 2358, "do": "attack", "id": "kabron", "target": "sofia", "dur": 2, "dmg": "душит", "kind": "melee"}, {"t": 2380, "do": "attack", "id": "sofia", "target": "kabron", "dur": 2, "dmg": "мимо", "kind": "melee"}, {"t": 2424, "do": "say", "id": "sofia", "text": "Превращаюсь в кобру!", "dur": 3}, {"t": 2437, "do": "attack", "id": "sofia", "target": "kabron", "dur": 2, "dmg": "1 + яд", "kind": "claw"}, {"t": 2479, "do": "hurt", "id": "kabron", "dmg": "5", "dur": 2, "kind": "poison"}, {"t": 2480, "do": "fx", "kind": "poison", "x": 86, "dur": 3}, {"t": 2490, "do": "status", "id": "kabron", "kind": "paralyzed"}, {"t": 2520, "do": "move", "id": "titus", "x": 66, "dur": 5}, {"t": 2523, "do": "say", "id": "sofia", "text": "Ещё раз выпустишь ребёнка — задушим всем комитетом!", "dur": 4.5}, {"t": 2533, "do": "say", "id": "titus", "text": "Я от неё с ума схожу!", "dur": 3}, {"t": 2538, "do": "move", "id": "sofia", "x": 40, "dur": 4}, {"t": 2540, "do": "move", "id": "titus", "x": 30, "dur": 4}, {"t": 2553, "do": "say", "id": "peasant1", "text": "А как насчёт нашего отпуска?", "dur": 3}, {"t": 2566, "do": "status", "id": "bagira", "kind": "invisible"}, {"t": 2574, "do": "move", "id": "peasant2", "x": 42, "dur": 4}, {"t": 2596, "do": "say", "id": "bagira", "text": "Я не дышу…", "dur": 2.5}, {"t": 2625, "do": "exit", "id": "peasant2", "x": 90, "dur": 4}, {"t": 2631, "do": "enter", "id": "shlepa", "x": 72, "from": 115, "dur": 8}, {"t": 2658, "do": "move", "id": "bagira", "x": 66, "dur": 10}, {"t": 2695, "do": "attack", "id": "bagira", "target": "shlepa", "dur": 2, "dmg": "нокаут", "kind": "melee"}, {"t": 2700, "do": "status", "id": "bagira", "kind": "none"}, {"t": 2701, "do": "status", "id": "shlepa", "kind": "sleep"}, {"t": 2720, "do": "say", "id": "bagira", "text": "Хочу замаскироваться под этого мужчину.", "dur": 4}, {"t": 2742, "do": "status", "id": "shlepa", "kind": "naked"}, {"t": 2766, "do": "enter", "id": "peasant2", "x": 55, "from": 100, "dur": 4}, {"t": 2768, "do": "say", "id": "peasant2", "text": "Одна золотая — и я ничего не видел.", "dur": 3.5}, {"t": 2790, "do": "exit", "id": "peasant2", "x": 100, "dur": 4}, {"t": 2825, "do": "enter", "id": "sofia", "x": 24, "from": -10, "dur": 5}, {"t": 2826, "do": "enter", "id": "yulian", "x": 32, "from": -10, "dur": 5}, {"t": 2827, "do": "enter", "id": "titus", "x": 40, "from": -10, "dur": 5}, {"t": 2828, "do": "enter", "id": "vitya", "x": 14, "from": -10, "dur": 5}, {"t": 2830, "do": "say", "id": "bagira", "text": "Без проблем, садитесь. Подкину в Плежу.", "dur": 3.5}, {"t": 2846, "do": "say", "id": "vitya", "text": "Начинаю есть капусту.", "dur": 3}, {"t": 2896, "do": "status", "id": "shlepa", "kind": "naked"}, {"t": 2936, "do": "say", "id": "sofia", "text": "Мужики, что делаете? Помощь нужна?", "dur": 3.5}, {"t": 2943, "do": "say", "id": "peasant1", "text": "Нет, не нужна. А вы кто такие?", "dur": 3}, {"t": 2947, "do": "say", "id": "peasant2", "text": "Шлёп, ты какой-то похорошел.", "dur": 3}, {"t": 2953, "do": "say", "id": "bagira", "text": "Высыпаюсь.", "dur": 2}, {"t": 2982, "do": "say", "id": "peasant3", "text": "Кони? Нет у нас их.", "dur": 3}, {"t": 2998, "do": "move", "id": "sofia", "x": 50, "dur": 4}, {"t": 3016, "do": "say", "id": "peasant1", "text": "Это наша повозка! Отойди от неё!", "dur": 3.5}, {"t": 3030, "do": "say", "id": "sofia", "text": "Это наша повозка!", "dur": 3}, {"t": 3047, "do": "say", "id": "peasant2", "text": "Мы соль земли. Ты хлеб ешь благодаря нам!", "dur": 4}, {"t": 3089, "do": "say", "id": "titus", "text": "Вы трое — концентрат говна, разбавленный водой!", "dur": 4.5}, {"t": 3121, "do": "attack", "id": "titus", "target": "peasant2", "dur": 3, "dmg": "5", "kind": "melee"}, {"t": 3137, "do": "die", "id": "peasant2"}, {"t": 3160, "do": "move", "id": "vitya", "x": 52, "dur": 4}, {"t": 3197, "do": "say", "id": "vitya", "text": "Решил окунуться!", "dur": 2.5}, {"t": 3208, "do": "attack", "id": "peasant1", "target": "titus", "dur": 2, "dmg": "толчок", "kind": "melee"}, {"t": 3220, "do": "say", "id": "titus", "text": "Стойте! Вашего друга убили, мы вам нового привезли!", "dur": 4.5}, {"t": 3240, "do": "attack", "id": "peasant3", "target": "titus", "dur": 2, "dmg": "толчок", "kind": "melee"}, {"t": 3244, "do": "move", "id": "titus", "x": 58, "dur": 2}, {"t": 3285, "do": "say", "id": "titus", "text": "Помогите, тут пиявки!", "dur": 3}, {"t": 3297, "do": "hurt", "id": "titus", "dmg": "4", "dur": 2, "kind": "leech"}, {"t": 3318, "do": "exit", "id": "peasant1", "x": 110, "dur": 4}, {"t": 3320, "do": "exit", "id": "peasant3", "x": 110, "dur": 4}, {"t": 3360, "do": "say", "id": "vitya", "text": "Напускаю на пиявку паразитический контроль.", "dur": 4}, {"t": 3400, "do": "say", "id": "vitya", "text": "Пиявка оказалась мудрее меня.", "dur": 3}, {"t": 3425, "do": "move", "id": "yulian", "x": 50, "dur": 5}, {"t": 3455, "do": "say", "id": "yulian", "text": "С моста бомбочкой!", "dur": 3}, {"t": 3462, "do": "move", "id": "yulian", "x": 57, "dur": 3}, {"t": 3484, "do": "fx", "kind": "explosion", "x": 57, "dur": 3}, {"t": 3490, "do": "say", "id": "yulian", "text": "Сосите, пиявки — вот мои кулаки!", "dur": 4}, {"t": 3540, "do": "move", "id": "titus", "x": 36, "dur": 4}, {"t": 3565, "do": "move", "id": "vitya", "x": 30, "dur": 5}, {"t": 3607, "do": "say", "id": "vitya", "text": "Это мои монеты! На них мои зубы.", "dur": 3.5}, {"t": 3620, "do": "move", "id": "sofia", "x": 40, "dur": 4}, {"t": 3652, "do": "say", "id": "sofia", "text": "Здесь напали существа, будто на ходулях.", "dur": 4}, {"t": 3745, "do": "say", "id": "titus", "text": "В кармане кукла Лёши!", "dur": 3}, {"t": 3782, "do": "status", "id": "shlepa", "kind": "none"}, {"t": 3792, "do": "attack", "id": "bagira", "target": "shlepa", "dur": 2, "dmg": "нокаут", "kind": "melee"}, {"t": 3796, "do": "status", "id": "shlepa", "kind": "naked"}, {"t": 3835, "do": "status", "id": "shlepa", "kind": "naked"}, {"t": 3856, "do": "say", "id": "sofia", "text": "Лес, что тут творится?", "dur": 3}, {"t": 3866, "do": "move", "id": "bagira", "x": 52, "dur": 3}, {"t": 3877, "do": "say", "id": "bagira", "text": "На ветках висят костяные куколки.", "dur": 3.5}, {"t": 3899, "do": "say", "id": "bagira", "text": "Софиш, проверь: они колдовские, опасные?", "dur": 4}, {"t": 3930, "do": "enter", "id": "zombie1", "x": 90, "from": 115, "dur": 7}, {"t": 3932, "do": "enter", "id": "zombie2", "x": 80, "from": 115, "dur": 8}, {"t": 3934, "do": "enter", "id": "zombie3", "x": 